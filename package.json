{
  "name": "@xqmsg/jssdk-core",
  "version": "3.0.0",
  "description": "A Javascript Implementation of XQ Message SDK, V.2",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "browser": "dist/browser/jssdk-core.min.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist/"
  ],
  "directories": {
    "test": "__tests__"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "build": "concurrently \"webpack --config webpack.config.js\" \"tsc -p tsconfig-esm.json\" \"tsc -p tsconfig-cjs.json\"",
    "lint": "eslint src/**  --ext .ts",
    "clean": "rm -rf node_modules && rm -rf dist",
    "test": "jest",
    "npm-publish": "yarn build && npm publish --access public",
    "yalc-publish": "yarn build && yalc publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XQ-Message-Inc/jssdk-core.git"
  },
  "keywords": [
    "security",
    "zero trust",
    "plug and play",
    "encryption",
    "AES",
    "XOR",
    "privacy",
    "quantum",
    "protection",
    "cyber",
    "cybersecurity"
  ],
  "author": "XQ Message",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/XQ-Message-Inc/jssdk-core/issues"
  },
  "homepage": "https://github.com/XQ-Message-Inc/jssdk-core#readme",
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.14",
    "@types/memory-cache": "^0.2.6",
    "@types/node": "^22.15.29",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "path-browserify": "^1.0.1",
    "prettier": "^3.5.3",
    "source-map-loader": "^5.0.0",
    "ts-jest": "^29.2.6",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "crypto-js": "^4.2.0",
    "jwt-decode": "^4.0.0",
    "memory-cache": "^0.2.0",
    "xhr2": "^0.2.1"
  }
}
